<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/admission.css">
</head>

<body>
    <!-- Floating Social Media Buttons -->
    <div class="floating-social">
        <a href="https://facebook.com" target="_blank" class="facebook" title="Facebook">
            <i class="fab fa-facebook-f"></i>
        </a>
        <a href="https://wa.me/2348131820224" target="_blank" class="whatsapp" title="WhatsApp">
            <i class="fab fa-whatsapp"></i>
        </a>
    </div>

    <!-- Navigation -->
    <nav class="navbar" id="navbar">
        <div class="container">
            <a href="/" class="logo">
                <div class="logo-icon">
                    <img src="/images/LEGEND_COLLEGE_LOGO_015925-removebg-preview.png" alt="">
                </div>
                <div class="logo-text">
                    Legend College
                    <span>of Nursing And Emergency Health Sciences Nnewi</span>
                </div>
            </a>
            <ul class="nav-links">
                <li><a href="/" class="nav-link">Home</a></li>
                <li class="dropdown">
                    <a href="" class="nav-link">About</a>
                    <div class="dropdown-menu">
                        <a href="/about">Overview</a>
                        <a href="/history">History</a>
                        <a href="/mission">Mission & Vision</a>
                    </div>
                </li>
                <li><a href="/admission" class="nav-link active">Admission</a></li>
                <li><a href="/contact" class="nav-link">Contact</a></li>
            </ul>
            <div class="mobile-toggle" onclick="toggleMobileMenu()">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-overlay" onclick="toggleMobileMenu()"></div>
    <div class="mobile-menu">
        <button class="mobile-menu-close" onclick="toggleMobileMenu()">&times;</button>
        <a href="/" onclick="toggleMobileMenu()">Home</a>
        <div class="mobile-dropdown">
            <a href="#" class="mobile-dropdown-toggle" onclick="toggleMobileDropdown(this, event)">
                About <span>&#9662;</span>
            </a>
            <div class="mobile-dropdown-menu">
                <a href="/about">Overview</a>
                <a href="/history">History</a>
                <a href="/mission">Mission & Vision</a>
            </div>
        </div>
        <a href="/admission" class="mobile-dropdown-toggle">Admission</a>
        <a href="/contact" onclick="toggleMobileMenu()">Contact</a>
    </div>

    <!-- Hero Section -->
    <section class="admission-hero">
        <div class="hero-content">
            <h1>Join Legend College of Nursing And Emergency Health Sciences Nnewi</h1>
            <p>Begin your journey towards a rewarding career in healthcare. Apply now and take the first step towards
                becoming a professional nurse.</p>
        </div>
    </section>

    <!-- Login Section -->
    <section class="login-section">
        <div class="container">
            <h2>Select Your Login Portal</h2>
            <div class="login-cards">
                <!-- Student Login -->
                <div class="login-card student-card">
                    <div class="login-card-icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                    <h3>Student Portal</h3>
                    <p>New students can register and submit their application forms. Existing students can check their
                        application status.</p>
                    <a href="/student-login" class="login-btn student-btn">Student Login</a>
                </div>

                <!-- Staff Login -->
                <div class="login-card staff-card">
                    <div class="login-card-icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                    <h3>Staff Portal</h3>
                    <p>Faculty and staff members can access the staff dashboard to manage applications and student
                        records.</p>
                    <a href="/staff-login" class="login-btn staff-btn">Staff Login</a>
                </div>

                <!-- Admin Login -->
                <div class="login-card admin-card">
                    <div class="login-card-icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h3>Admin Portal</h3>
                    <p>Administrators can access the admin dashboard to review applications, manage staff, and oversee
                        admissions.</p>
                    <a href="/admin-login" class="login-btn admin-btn">Admin Login</a>
                </div>
            </div>
        </div>
    </section>


    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-wave">
            <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
                <path d="M0,64 C480,150 960,-20 1440,64 L1440,0 L0,0 Z" fill="currentColor"></path>
            </svg>
        </div>

        <div class="footer-main">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-about">
                        <div class="footer-logo">
                            <!-- <div class="footer-logo-icon">LC</div> -->
                            <div class="footer-logo-icon">
                                <img src="/images/LEGEND_COLLEGE_LOGO_015925-removebg-preview.png" alt="">
                            </div>
                            <div class="footer-logo-text">
                                Legend College
                                <span>of Nursing And Emergency Health Sciences Nnewi</span>
                            </div>
                        </div>
                        <p class="footer-tagline">Excellence in Healthcare Education</p>
                        <div class="footer-socials">
                            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                            <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        </div>
                    </div>

                    <div class="footer-nav">
                        <h4>Quick Links</h4>
                        <ul>
                            <li><a href="/"><i class="fas fa-chevron-right"></i> Home</a></li>
                            <li><a href="/about"><i class="fas fa-chevron-right"></i> About Us</a></li>
                            <li><a href="/programs"><i class="fas fa-chevron-right"></i> Programs</a></li>
                            <li><a href="/admission"><i class="fas fa-chevron-right"></i> Admission</a></li>
                            <li><a href="/contact"><i class="fas fa-chevron-right"></i> Contact</a></li>
                        </ul>
                    </div>

                    <div class="footer-contact">
                        <h4>Contact Us</h4>
                        <ul>
                            <li>
                                <i class="fas fa-map-marker-alt"></i>
                                <span>Ambassador Plaza, Opp. Convaj Hotel, Nnewi</span>
                            </li>
                            <li>
                                <i class="fas fa-phone-alt"></i>
                                <span>+234 813 182 0224</span>
                            </li>
                            <li>
                                <i class="fas fa-envelope"></i>
                                <span>info@legendcollege25@gmail.com</span>
                            </li>
                            <li>
                                <i class="fas fa-clock"></i>
                                <span>Mon - Fri: 8:00 AM - 5:00 PM</span>
                            </li>
                        </ul>
                    </div>

                    <div class="footer-newsletter">
                        <h4>Stay Updated</h4>
                        <p>Subscribe to our newsletter for the latest updates on admissions and programs.</p>
                        <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
                            <input type="email" placeholder="Enter your email" required>
                            <button type="submit"><i class="fas fa-paper-plane"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2026 Legend College of Nursing And Emergency Health Sciences Nnewi. All Rights Reserved.</p>
                <div class="footer-legal">
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Use</a>
                    <a href="#">Cookie Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Back to Top Button -->
    <div class="back-to-top" onclick="scrollToTop()">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
    </div>

    <script src="/js/index.js"></script>
</body>

</html>