<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Dashboard | Legend College of Nursing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/admission.css">
</head>

<body class="dashboard-page">
    <!-- Dashboard Header -->
    <header class="dashboard-header">
        <div class="logo">
            <img src="/images/LEGEND_COLLEGE_LOGO_015925-removebg-preview.png" alt="Logo">
            <h2>Staff Dashboard</h2>
        </div>
        <div class="user-info">
            <span>Welcome, <strong><%= staff ? staff.fullName : 'Staff' %></strong></span>
            <a href="/staff-logout" class="logout-btn">Logout</a>
        </div>
    </header>

    <!-- Dashboard Content -->
    <div class="dashboard-content">
        <!-- Statistics -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <h4>Total Applications</h4>
                <div class="value"><%= stats.total %></div>
            </div>
            <div class="stat-card pending">
                <h4>Pending Review</h4>
                <div class="value"><%= stats.pending %></div>
            </div>
            <div class="stat-card approved">
                <h4>Approved</h4>
                <div class="value"><%= stats.approved %></div>
            </div>
            <div class="stat-card rejected">
                <h4>Rejected</h4>
                <div class="value"><%= stats.rejected %></div>
            </div>
        </div>

        <!-- Applications Table -->
        <div class="applications-table">
            <h3>All Applications</h3>
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>
            
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>

            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Program</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (students && students.length > 0) { %>
                        <% students.forEach(function(student) { %>
                            <tr>
                                <td><%= student.firstName %> <%= student.lastName %></td>
                                <td><%= student.email %></td>
                                <td><%= student.phone %></td>
                                <td><%= student.program %></td>
                                <td>
                                    <span class="status-badge <%= student.paymentStatus %>">
                                        <%= student.paymentStatus %>
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge <%= student.applicationStatus %>">
                                        <%= student.applicationStatus.replace('_', ' ') %>
                                    </span>
                                </td>
                                <td><%= new Date(student.createdAt).toLocaleDateString() %></td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 30px;">No applications found</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <footer class="footer" style="margin-top: 60px;">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a href="/" class="logo">
                        <div class="logo-icon">LC</div>
                        <div class="logo-text">
                            Legend College
                            <span>of Nursing Sciences</span>
                        </div>
                    </a>
                </div>
                <div class="footer-bottom">
                    <p>&copy; 2026 Legend College of Nursing Sciences. All Rights Reserved.</p>
                </div>
            </div>
        </div>
    </footer>
    <script src="/js/index.js"></script>
</body>

</html>
