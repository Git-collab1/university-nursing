<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/mission.css">
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar" id="navbar">
        <div class="container">
            <a href="/" class="logo">
                <div class="logo-icon">
                    <img src="/images/LEGEND_COLLEGE_LOGO_015925-removebg-preview.png" alt="">
                </div>
                <div class="logo-text">
                    Legend College
                    <span>of Nursing And Emergency Health Sciences Nnewi</span>
                </div>
            </a>
            <ul class="nav-links">
                <li><a href="/" class="nav-link">Home</a></li>
                <li class="dropdown">
                    <a href="" class="nav-link">About</a>
                    <div class="dropdown-menu">
                        <a href="/about">Overview</a>
                        <a href="/history">History</a>
                        <a href="/mission">Mission & Vision</a>
                    </div>
                </li>
                <li><a href="/admission" class="nav-link">Admission</a></li>
                <li><a href="/contact" class="nav-link">Contact</a></li>
            </ul>
            <div class="mobile-toggle" onclick="toggleMobileMenu()">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-overlay" onclick="toggleMobileMenu()"></div>
    <div class="mobile-menu">
        <button class="mobile-menu-close" onclick="toggleMobileMenu()">&times;</button>
        <a href="/" onclick="toggleMobileMenu()">Home</a>
        <div class="mobile-dropdown">
            <a href="#" class="mobile-dropdown-toggle" onclick="toggleMobileDropdown(this)">
                About <span>&#9662;</span>
            </a>
            <div class="mobile-dropdown-menu">
                <a href="/about">Overview</a>
                <a href="/history">History</a>
                <a href="/mission">Mission & Vision</a>
            </div>
        </div>
        <a href="/admission" class="mobile-dropdown-toggle">Admission</a>
        <a href="/contact" onclick="toggleMobileMenu()">Contact</a>
    </div>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h1>Mission & Vision</h1>
            <p>Guiding principles that drive our commitment to nursing excellence</p>
            <div class="breadcrumb">
                <a href="/">Home</a>
                <span>/</span>
                <span>Mission & Vision</span>
            </div>
        </div>
    </section>

    <!-- Mission Vision Section -->
    <section class="mv-section">
        <div class="container">
            <div class="section-header fade-in-section">
                <div class="subtitle">Our Foundation</div>
                <h2>What Drives Us</h2>
                <p>The core principles that guide every aspect of our nursing education</p>
            </div>
            <div class="mv-grid">
                <div class="mv-card fade-in-section">
                    <div class="mv-icon">🎯</div>
                    <h3>Our Mission</h3>
                    <p>To provide excellence in nursing education through innovative teaching, hands-on clinical
                        training, and research that prepares compassionate, skilled, and competent nurses to meet the
                        evolving healthcare needs of Nigeria and the global community.</p>
                    <ul class="mv-list">
                        <li>Deliver comprehensive nursing education</li>
                        <li>Foster clinical excellence</li>
                        <li>Promote evidence-based practice</li>
                        <li>Develop leaders in healthcare</li>
                    </ul>
                </div>
                <div class="mv-card fade-in-section">
                    <div class="mv-icon">🔭</div>
                    <h3>Our Vision</h3>
                    <p>To be the leading institution in nursing education in Nigeria and beyond, recognized for
                        producing nurses who embody compassion, expertise, and leadership in transforming healthcare
                        delivery and improving population health outcomes.</p>
                    <ul class="mv-list">
                        <li>Be a center of nursing excellence</li>
                        <li>Innovate in healthcare education</li>
                        <li>Shape the future of nursing</li>
                        <li>Impact global health positively</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values Section -->
    <section class="values-section">
        <div class="container">
            <div class="section-header fade-in-section">
                <div class="subtitle">What We Stand For</div>
                <h2>Our Core Values</h2>
                <p>The values that define our culture and guide our actions</p>
            </div>
            <div class="values-grid">
                <div class="value-card fade-in-section">
                    <div class="value-icon">💙</div>
                    <h3>Compassion</h3>
                    <p>We treat every patient with empathy, kindness, and respect, recognizing the humanity in each
                        individual we serve.</p>
                </div>
                <div class="value-card fade-in-section">
                    <div class="value-icon">⭐</div>
                    <h3>Excellence</h3>
                    <p>We strive for the highest standards in education, clinical practice, and research to produce
                        outstanding nurses.</p>
                </div>
                <div class="value-card fade-in-section">
                    <div class="value-icon">🔬</div>
                    <h3>Innovation</h3>
                    <p>We embrace new ideas and technologies to advance nursing education and healthcare delivery.</p>
                </div>
                <div class="value-card fade-in-section">
                    <div class="value-icon">🤝</div>
                    <h3>Integrity</h3>
                    <p>We uphold ethical standards and professional conduct in all our interactions and decisions.</p>
                </div>
                <div class="value-card fade-in-section">
                    <div class="value-icon">👥</div>
                    <h3>Collaboration</h3>
                    <p>We work together as a team, partnering with healthcare institutions and communities for better
                        outcomes.</p>
                </div>
                <div class="value-card fade-in-section">
                    <div class="value-icon">📚</div>
                    <h3>Learning</h3>
                    <p>We foster a culture of continuous learning and professional development throughout one's career.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Goals Section -->
    <section class="goals-section">
        <div class="container">
            <div class="section-header fade-in-section">
                <div class="subtitle">Our Direction</div>
                <h2>Strategic Goals</h2>
                <p>Our roadmap for achieving excellence in nursing education</p>
            </div>
            <div class="goals-grid">
                <div class="goal-card fade-in-section">
                    <span class="goal-number">01</span>
                    <h3>Expand Access</h3>
                    <p>Increase access to quality nursing education across Nigeria through innovative programs and
                        partnerships.</p>
                </div>
                <div class="goal-card fade-in-section">
                    <span class="goal-number">02</span>
                    <h3>Enhance Quality</h3>
                    <p>Continuously improve our curriculum and teaching methods to meet international standards.</p>
                </div>
                <div class="goal-card fade-in-section">
                    <span class="goal-number">03</span>
                    <h3>Build Partnerships</h3>
                    <p>Establish strong partnerships with healthcare institutions for clinical training and research.
                    </p>
                </div>
                <div class="goal-card fade-in-section">
                    <span class="goal-number">04</span>
                    <h3>Develop Leaders</h3>
                    <p>Nurture nurse leaders who will shape the future of healthcare in Nigeria and beyond.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section">
        <div class="container">
            <div class="cta-content">
                <h2>Join Our Mission</h2>
                <p>Be part of transforming healthcare through excellence in nursing education.</p>
                <a href="/" class="btn btn-white">Enroll Today</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-wave">
            <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
                <path d="M0,64 C480,150 960,-20 1440,64 L1440,0 L0,0 Z" fill="currentColor"></path>
            </svg>
        </div>

        <div class="footer-main">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-about">
                        <div class="footer-logo">
                            <div class="footer-logo-icon">LC</div>
                            <div class="footer-logo-text">
                                Legend College
                                <span>of Nursing And Emergency Health Sciences Nnewi</span>
                            </div>
                        </div>
                        <p class="footer-tagline">Excellence in Healthcare Education</p>
                        <div class="footer-socials">
                            <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                            <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                            <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        </div>
                    </div>

                    <div class="footer-nav">
                        <h4>Quick Links</h4>
                        <ul>
                            <li><a href="/"><i class="fas fa-chevron-right"></i> Home</a></li>
                            <li><a href="/about"><i class="fas fa-chevron-right"></i> About Us</a></li>
                            <li><a href="/programs"><i class="fas fa-chevron-right"></i> Programs</a></li>
                            <li><a href="/admission"><i class="fas fa-chevron-right"></i> Admission</a></li>
                            <li><a href="/contact"><i class="fas fa-chevron-right"></i> Contact</a></li>
                        </ul>
                    </div>

                    <div class="footer-contact">
                        <h4>Contact Us</h4>
                        <ul>
                            <li>
                                <i class="fas fa-map-marker-alt"></i>
                                <span>Ambassador Plaza, Opp. Convaj Hotel, Nnewi</span>
                            </li>
                            <li>
                                <i class="fas fa-phone-alt"></i>
                                <span>+234 813 182 0224</span>
                            </li>
                            <li>
                                <i class="fas fa-envelope"></i>
                                <span>info@legendcollege25@gmail.com</span>
                            </li>
                            <li>
                                <i class="fas fa-clock"></i>
                                <span>Mon - Fri: 8:00 AM - 5:00 PM</span>
                            </li>
                        </ul>
                    </div>

                    <div class="footer-newsletter">
                        <h4>Stay Updated</h4>
                        <p>Subscribe to our newsletter for the latest updates on admissions and programs.</p>
                        <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed!');">
                            <input type="email" placeholder="Enter your email" required>
                            <button type="submit"><i class="fas fa-paper-plane"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2026 Legend College of Nursing And Emergency Health Sciences Nnewi. All Rights Reserved.</p>
                <div class="footer-legal">
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Use</a>
                    <a href="#">Cookie Policy</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Back to Top Button -->
    <div class="back-to-top" onclick="scrollToTop()">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
    </div>
    <script src="/js/mission.js"></script>
</body>

</html>