<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Application Form | Legend College
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- <link rel="stylesheet" href="/css/index.css"> -->
    <!-- <link rel="stylesheet" href="/css/admission.css"> -->

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: "Poppins", sans-serif;
            background: #f5f7f8;
            color: #333;
        }

        .form-page {
            min-height: 100vh;
            padding: 100px 20px 50px;
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
        }

        .application-form {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .comprehensive-form {
            padding: 25px;
        }

        .form-header-section {
            display: grid;
            grid-template-columns: 1fr 250px 150px;
            gap: 20px;
            align-items: center;
            padding-bottom: 25px;
            border-bottom: 2px solid #00695c;
            margin-bottom: 25px;
        }

        .header-info h1 {
            margin: 0 0 8px;
            color: #00695c;
            font-family: "Playfair Display", serif;
            font-size: 25px;
            line-height: 1.3;
        }

        .header-info p {
            margin: 0;
            color: #666;
        }

        .receipt-section {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .receipt-field {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .passport-area {
            height: 150px;
            border: 2px dashed #aaa;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            overflow: hidden;
            background: #fafafa;
            text-align: center;
        }

        .passport-area i {
            font-size: 32px;
            color: #00695c;
            margin-bottom: 8px;
        }

        .passport-area span {
            color: #666;
            font-size: 13px;
        }

        .passport-area img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .instructions-box {
            background: #f0f7f6;
            border-left: 4px solid #00695c;
            padding: 18px;
            margin-bottom: 25px;
            border-radius: 6px;
        }

        .instructions-box h4 {
            color: #00695c;
            margin-top: 0;
            margin-bottom: 10px;
        }

        .instructions-box ol {
            margin: 0;
            padding-left: 20px;
        }

        .instructions-box li {
            margin-bottom: 6px;
        }

        .instructions-box .note {
            margin-bottom: 0;
            font-weight: 600;
        }

        .form-part {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .form-part>h3 {
            margin-top: 0;
            margin-bottom: 20px;
            color: #00695c;
            font-family: "Playfair Display", serif;
            border-bottom: 1px solid #ddd;
            padding-bottom: 10px;
        }

        .sub-section {
            margin-bottom: 22px;
        }

        .sub-section:last-child {
            margin-bottom: 0;
        }

        .sub-section-label {
            display: block;
            font-weight: 600;
            margin-bottom: 10px;
            color: #444;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .form-grid.three {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-group.full-width {
            width: 100%;
        }

        label {
            font-size: 14px;
            font-weight: 600;
            color: #444;
        }

        .required {
            color: #e53935;
        }

        input,
        select,
        textarea {
            width: 100%;
            font-family: "Poppins", sans-serif;
            font-size: 14px;
            padding: 11px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            background: #fff;
            color: #333;
        }

        textarea {
            resize: vertical;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            border-color: #00695c;
            box-shadow: 0 0 0 2px rgba(0, 105, 92, 0.08);
        }

        .radio-group,
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
        }

        .radio-item,
        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .radio-item input,
        .checkbox-item input {
            width: 18px;
            height: 18px;
            accent-color: #00695c;
        }

        .radio-item label,
        .checkbox-item label {
            font-size: 14px;
            cursor: pointer;
            font-weight: 400;
        }

        .exam-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .exam-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 13px;
            min-width: 550px;
        }

        .exam-table th,
        .exam-table td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
        }

        .exam-table th {
            background: #00695c;
            color: #fff;
            font-weight: 600;
        }

        .exam-table input {
            width: 100%;
            border: none;
            background: transparent;
            text-align: center;
            font-size: 13px;
        }

        .exam-table input:focus {
            outline: none;
            background: #f0f7f6;
            box-shadow: none;
        }

        .file-upload-wrapper {
            position: relative;
        }

        .file-upload-wrapper input[type="file"] {
            display: none;
        }

        .file-upload-area {
            border: 2px dashed #ccc;
            border-radius: 8px;
            padding: 25px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
            background: #f9f9f9;
        }

        .file-upload-area:hover {
            border-color: #00695c;
            background: #f0f7f6;
        }

        .file-upload-area i {
            font-size: 28px;
            color: #00695c;
            margin-bottom: 8px;
            display: block;
        }

        .file-upload-area span {
            font-size: 13px;
            color: #666;
        }

        .file-preview {
            margin-top: 10px;
            text-align: center;
        }

        .file-preview img {
            max-width: 100%;
            max-height: 150px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .file-preview .pdf-preview {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .file-preview .pdf-preview i {
            color: #e74c3c;
            font-size: 20px;
        }

        .file-preview .pdf-preview span {
            font-size: 13px;
            color: #333;
        }

        .declaration-box {
            background: #e8f5e9;
            border: 2px solid #00695c;
            padding: 20px;
            border-radius: 8px;
            margin-top: 25px;
        }

        .declaration-box h4 {
            color: #00695c;
            margin-bottom: 15px;
        }

        .declaration-text {
            font-size: 14px;
            line-height: 1.6;
            color: #333;
        }

        .submit-btn {
            background: #00695c;
            color: #fff;
            padding: 15px 30px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            margin-top: 25px;
            transition: background 0.3s;
        }

        .submit-btn:hover {
            background: #004d40;
        }

        .submit-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .alert {
            padding: 15px;
            border-radius: 6px;
            margin-bottom: 20px;
        }

        .alert-error {
            background: #ffebee;
            border: 1px solid #ef9a9a;
            color: #b71c1c;
        }

        .floating-social {
            position: fixed;
            right: 18px;
            bottom: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 999;
        }

        .floating-social a {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
        }

        .floating-social .facebook {
            background: #1877f2;
        }

        .floating-social .whatsapp {
            background: #25d366;
        }

        @media (max-width: 900px) {
            .form-header-section {
                grid-template-columns: 1fr;
            }

            .passport-area {
                width: 150px;
            }

            .form-grid.three {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .form-page {
                padding: 80px 10px 30px;
            }

            .comprehensive-form {
                padding: 15px;
            }

            .form-part {
                padding: 15px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .radio-group,
            .checkbox-group {
                flex-direction: column;
                gap: 10px;
            }

            .header-info h1 {
                font-size: 20px;
            }

            .passport-area {
                width: 100%;
                height: 120px;
            }
        }
    </style>
</head>

<body>

    <!-- Floating Social Media Buttons -->
    <div class="floating-social">

        <a href="https://facebook.com" target="_blank" class="facebook" title="Facebook">
            <i class="fab fa-facebook-f"></i>
        </a>

        <a href="https://wa.me/2348131820224" target="_blank" class="whatsapp" title="WhatsApp">
            <i class="fab fa-whatsapp"></i>
        </a>

    </div>

    <!-- Form Page -->
    <div class="form-page">

        <div class="container">

            <div class="application-form">

                <% if (typeof error !=="undefined" && error) { %>

                    <div class="alert alert-error" style="font-size: 1.1rem; padding: 18px 22px;">

                        <strong>
                            <i class="fas fa-exclamation-circle"></i>
                            Error:
                        </strong>

                        <%= error %>

                    </div>

                    <% } %>

                        <form action="/student-submit-form" method="POST" id="applicationForm"
                            enctype="multipart/form-data" class="comprehensive-form">

                            <!-- =========================================
                         HEADER
                    ========================================== -->

                            <div class="form-header-section">

                                <div class="header-info">

                                    <h1>
                                        LEGEND COLLEGE OF NURSING
                                        AND EMERGENCY HEALTH SCIENCE NNEWI
                                    </h1>

                                    <p>
                                        Application Form for Admission
                                    </p>

                                </div>

                                <div class="receipt-section">

                                    <div class="receipt-field">

                                        <label for="receiptNo">
                                            Receipt No.
                                        </label>

                                        <input type="text" id="receiptNo" name="receiptNo"
                                            value="<%= student ? student.receiptNo : '' %>"
                                            placeholder="Enter receipt number">

                                    </div>

                                    <div class="receipt-field">

                                        <label for="applicationDate">
                                            Application Date
                                        </label>

                                        <input type="date" id="applicationDate" name="applicationDate" value="<%= student && student.applicationDate
                                        ? student.applicationDate.toISOString().split('T')[0]
                                        : '' %>">

                                    </div>

                                </div>

                                <div class="passport-area" id="passportArea"
                                    onclick="document.getElementById('passportPhoto').click()">

                                    <i class="fas fa-camera"></i>

                                    <span>
                                        Candidate's Passport
                                    </span>

                                    <input type="file" id="passportPhoto" name="passportPhoto"
                                        accept="image/jpeg,image/png,image/jpg" style="display: none;">

                                </div>

                            </div>

                            <!-- =========================================
                         INSTRUCTIONS
                    ========================================== -->

                            <div class="instructions-box">

                                <h4>
                                    <i class="fas fa-info-circle"></i>
                                    Important Instructions
                                </h4>

                                <ol>

                                    <li>
                                        Please complete this form in
                                        <strong>BLACK INK</strong>
                                    </li>

                                    <li>
                                        Tick the box which applies to you
                                    </li>

                                    <li>
                                        Return with the following:

                                        <ul>

                                            <li>
                                                i. Photocopies of your credentials
                                            </li>

                                            <li>
                                                ii. Four passport-sized photographs
                                                (not more than three months old)
                                            </li>

                                            <li>
                                                iii. An international passport
                                            </li>

                                        </ul>

                                    </li>

                                </ol>

                                <p class="note">
                                    Note: Incomplete forms will not be processed.
                                </p>

                            </div>

                            <!-- =========================================
                         PART 1
                    ========================================== -->

                            <div class="form-part">

                                <h3>
                                    <i class="fas fa-user"></i>
                                    1. PERSONAL DATA OF APPLICANT
                                </h3>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        a. Name:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label for="title">
                                                Title
                                                <span class="required">*</span>
                                            </label>

                                            <select id="title" name="title">

                                                <option value="">
                                                    Select
                                                </option>

                                                <option value="Mr." <%=student && student.title==="Mr." ? "selected"
                                                    : "" %>
                                                    >
                                                    Mr.
                                                </option>

                                                <option value="Miss" <%=student && student.title==="Miss" ? "selected"
                                                    : "" %>
                                                    >
                                                    Miss
                                                </option>

                                                <option value="Mrs." <%=student && student.title==="Mrs." ? "selected"
                                                    : "" %>
                                                    >
                                                    Mrs.
                                                </option>

                                            </select>

                                        </div>

                                        <div class="form-group">

                                            <label for="firstName">
                                                First Name
                                                <span class="required">*</span>
                                            </label>

                                            <input type="text" id="firstName" name="firstName"
                                                value="<%= student ? student.firstName : '' %>"
                                                placeholder="Enter first name" required>

                                        </div>

                                        <div class="form-group">

                                            <label for="lastName">
                                                Last Name
                                                <span class="required">*</span>
                                            </label>

                                            <input type="text" id="lastName" name="lastName"
                                                value="<%= student ? student.lastName : '' %>"
                                                placeholder="Enter last name" required>

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        b. Contact Address:
                                    </span>

                                    <div class="form-group full-width">

                                        <textarea id="contactAddress" name="contactAddress"
                                            placeholder="Enter your contact address"
                                            rows="2"><%= student && student.contactAddress ? student.contactAddress : '' %></textarea>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        c. Sex: &nbsp;&nbsp; Date of Birth:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label>
                                                Sex
                                                <span class="required">*</span>
                                            </label>

                                            <div class="radio-group">

                                                <div class="radio-item">

                                                    <input type="radio" id="male" name="gender" value="Male" <%=student
                                                        && student.gender==="Male" ? "checked" : "" %>
                                                    required
                                                    >

                                                    <label for="male">
                                                        Male
                                                    </label>

                                                </div>

                                                <div class="radio-item">

                                                    <input type="radio" id="female" name="gender" value="Female"
                                                        <%=student && student.gender==="Female" ? "checked" : "" %>
                                                    required
                                                    >

                                                    <label for="female">
                                                        Female
                                                    </label>

                                                </div>

                                            </div>

                                        </div>

                                        <div class="form-group">

                                            <label for="dateOfBirth">
                                                Date of Birth
                                                <span class="required">*</span>
                                            </label>

                                            <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= student && student.dateOfBirth
                                            ? student.dateOfBirth.toISOString().split('T')[0]
                                            : '' %>" required>

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        d. Marital Status:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label for="maritalStatus">
                                                Marital Status
                                                <span class="required">*</span>
                                            </label>

                                            <select id="maritalStatus" name="maritalStatus" required>

                                                <option value="">
                                                    Select
                                                </option>

                                                <option value="Single" <%=student && student.maritalStatus==="Single"
                                                    ? "selected" : "" %>
                                                    >
                                                    Single
                                                </option>

                                                <option value="Married" <%=student && student.maritalStatus==="Married"
                                                    ? "selected" : "" %>
                                                    >
                                                    Married
                                                </option>

                                                <option value="Divorced" <%=student &&
                                                    student.maritalStatus==="Divorced" ? "selected" : "" %>
                                                    >
                                                    Divorced
                                                </option>

                                                <option value="Widowed" <%=student && student.maritalStatus==="Widowed"
                                                    ? "selected" : "" %>
                                                    >
                                                    Widowed
                                                </option>

                                            </select>

                                        </div>

                                        <div class="form-group">

                                            <label for="maidenName">
                                                Maiden Name (if married)
                                            </label>

                                            <input type="text" id="maidenName" name="maidenName"
                                                value="<%= student ? student.maidenName : '' %>"
                                                placeholder="Enter maiden name">

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        e. Phone No.: &nbsp;&nbsp; Email:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label for="phone">
                                                Phone Number
                                                <span class="required">*</span>
                                            </label>

                                            <input type="tel" id="phone" name="phone"
                                                value="<%= student ? student.phone : '' %>"
                                                placeholder="+234 xxx xxx xxxx" required>

                                        </div>

                                        <div class="form-group">

                                            <label for="email">
                                                Email
                                                <span class="required">*</span>
                                            </label>

                                            <input type="email" id="email" name="email"
                                                value="<%= student ? student.email : '' %>"
                                                placeholder="Enter email address" required>

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        f. State of Origin: &nbsp;&nbsp; Nationality:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label for="stateOfOrigin">
                                                State of Origin
                                                <span class="required">*</span>
                                            </label>

                                            <input type="text" id="stateOfOrigin" name="stateOfOrigin"
                                                value="<%= student ? student.stateOfOrigin : '' %>"
                                                placeholder="Enter state" required>

                                        </div>

                                        <div class="form-group">

                                            <label for="nationality">
                                                Nationality
                                                <span class="required">*</span>
                                            </label>

                                            <input type="text" id="nationality" name="nationality"
                                                value="<%= student ? student.nationality : 'Nigerian' %>" required>

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        g. Local Government Area:
                                    </span>

                                    <div class="form-group">

                                        <input type="text" id="localGovernmentArea" name="localGovernmentArea"
                                            value="<%= student ? student.localGovernmentArea : '' %>"
                                            placeholder="Enter LGA">

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        h. Extra Curricular Activities:
                                    </span>

                                    <div class="form-group full-width">

                                        <textarea id="extraCurricularActivities" name="extraCurricularActivities"
                                            placeholder="List any sports, hobbies, or extra-curricular activities"
                                            rows="2"><%= student && student.extraCurricularActivities
                                    ? student.extraCurricularActivities
                                    : "" %></textarea>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        i. Medical History:
                                    </span>

                                    <div class="form-group full-width">

                                        <textarea id="medicalHistory" name="medicalHistory"
                                            placeholder="List any medical conditions or history" rows="2"><%= student && student.medicalHistory
                                    ? student.medicalHistory
                                    : "" %></textarea>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        j. Genotype:
                                    </span>

                                    <div class="form-group">

                                        <select id="genotype" name="genotype">

                                            <option value="">
                                                Select
                                            </option>

                                            <option value="AA" <%=student && student.genotype==="AA" ? "selected" : ""
                                                %>
                                                >
                                                AA
                                            </option>

                                            <option value="AS" <%=student && student.genotype==="AS" ? "selected" : ""
                                                %>
                                                >
                                                AS
                                            </option>

                                            <option value="SS" <%=student && student.genotype==="SS" ? "selected" : ""
                                                %>
                                                >
                                                SS
                                            </option>

                                            <option value="AC" <%=student && student.genotype==="AC" ? "selected" : ""
                                                %>
                                                >
                                                AC
                                            </option>

                                        </select>

                                    </div>

                                </div>

                            </div>

                            <!-- =========================================
                         PART 2
                    ========================================== -->

                            <div class="form-part">

                                <h3>
                                    <i class="fas fa-users"></i>
                                    2. INFORMATION ABOUT APPLICANT'S PARENTS
                                </h3>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        a. Father's Full Name:
                                    </span>

                                    <div class="form-group">

                                        <input type="text" id="fatherFullName" name="fatherFullName"
                                            value="<%= student ? student.fatherFullName : '' %>"
                                            placeholder="Enter father's full name">

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        b. Father's Contact Address:
                                    </span>

                                    <div class="form-group full-width">

                                        <textarea id="fatherContactAddress" name="fatherContactAddress"
                                            placeholder="Enter father's contact address" rows="2"><%= student && student.fatherContactAddress
                                    ? student.fatherContactAddress
                                    : "" %></textarea>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        c. Phone No.: &nbsp;&nbsp; Email:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label for="fatherPhone">
                                                Father's Phone
                                            </label>

                                            <input type="tel" id="fatherPhone" name="fatherPhone"
                                                value="<%= student ? student.fatherPhone : '' %>"
                                                placeholder="+234 xxx xxx xxxx">

                                        </div>

                                        <div class="form-group">

                                            <label for="fatherEmail">
                                                Father's Email
                                            </label>

                                            <input type="email" id="fatherEmail" name="fatherEmail"
                                                value="<%= student ? student.fatherEmail : '' %>"
                                                placeholder="Enter email">

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        d. Mother's Full Name: &nbsp;&nbsp; Maiden Name:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label for="motherFullName">
                                                Mother's Full Name
                                            </label>

                                            <input type="text" id="motherFullName" name="motherFullName"
                                                value="<%= student ? student.motherFullName : '' %>"
                                                placeholder="Enter mother's full name">

                                        </div>

                                        <div class="form-group">

                                            <label for="motherMaidenName">
                                                Mother's Maiden Name
                                            </label>

                                            <input type="text" id="motherMaidenName" name="motherMaidenName"
                                                value="<%= student ? student.motherMaidenName : '' %>"
                                                placeholder="Enter maiden name">

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        e. Mother's Contact Address:
                                    </span>

                                    <div class="form-group full-width">

                                        <textarea id="motherContactAddress" name="motherContactAddress"
                                            placeholder="Enter mother's contact address" rows="2"><%= student && student.motherContactAddress
                                    ? student.motherContactAddress
                                    : "" %></textarea>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        f. Phone No.: &nbsp;&nbsp; Email:
                                    </span>

                                    <div class="form-grid">

                                        <div class="form-group">

                                            <label for="motherPhone">
                                                Mother's Phone
                                            </label>

                                            <input type="tel" id="motherPhone" name="motherPhone"
                                                value="<%= student ? student.motherPhone : '' %>"
                                                placeholder="+234 xxx xxx xxxx">

                                        </div>

                                        <div class="form-group">

                                            <label for="motherEmail">
                                                Mother's Email
                                            </label>

                                            <input type="email" id="motherEmail" name="motherEmail"
                                                value="<%= student ? student.motherEmail : '' %>"
                                                placeholder="Enter email">

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <!-- =========================================
                         PART 3
                    ========================================== -->

                            <div class="form-part">

                                <h3>
                                    <i class="fas fa-book"></i>
                                    3. CHOICE OF COURSE
                                </h3>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        a. Please indicate your choice:
                                    </span>

                                    <div class="radio-group">

                                        <div class="radio-item">

                                            <input type="radio" id="hndNursing" name="program" value="HND Nursing"
                                                <%=student && student.program==="HND Nursing" ? "checked" : "" %>
                                            required
                                            >

                                            <label for="hndNursing">
                                                HND Nursing
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="bnsNursing" name="program" value="BNSc Nursing"
                                                <%=student && student.program==="BNSc Nursing" ? "checked" : "" %>
                                            >

                                            <label for="bnsNursing">
                                                BNSc Nursing
                                            </label>

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        b. Program Transfer:
                                    </span>

                                    <div class="form-group">

                                        <label>
                                            Will you like to finish your academic
                                            program outside Nigeria?
                                        </label>

                                        <div class="radio-group">

                                            <div class="radio-item">

                                                <input type="radio" id="transferYes" name="programTransfer" value="Yes"
                                                    <%=student && student.programTransfer==="Yes" ? "checked" : "" %>
                                                >

                                                <label for="transferYes">
                                                    Yes
                                                </label>

                                            </div>

                                            <div class="radio-item">

                                                <input type="radio" id="transferNo" name="programTransfer" value="No"
                                                    <%=student && student.programTransfer==="No" ? "checked" : "" %>
                                                >

                                                <label for="transferNo">
                                                    No
                                                </label>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <!-- =========================================
                         PART 4: EDUCATION
                    ========================================== -->

                            <div class="form-part">

                                <h3>
                                    <i class="fas fa-graduation-cap"></i>
                                    4. EDUCATION
                                </h3>

                                <!-- Academic Background -->

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        a. Academic Background:
                                    </span>

                                    <div class="form-group">

                                        <label for="academicBackground">

                                            Academic Background

                                            <span class="required">
                                                *
                                            </span>

                                        </label>

                                        <select id="academicBackground" name="academicBackground" required>

                                            <option value="">
                                                Select Academic Background
                                            </option>

                                            <option value="science" <%=student && student.academicBackground==="science"
                                                ? "selected" : "" %>
                                                >
                                                Science
                                            </option>

                                            <option value="non_science" <%=student &&
                                                student.academicBackground==="non_science" ? "selected" : "" %>
                                                >
                                                Non-Science
                                            </option>

                                        </select>

                                    </div>

                                    <p style="
                                    margin-top: 8px;
                                    color: #666;
                                    font-size: 12px;
                                ">
                                        This information determines whether you will
                                        receive the online science interview or attend
                                        a physical interview.
                                    </p>

                                </div>

                                <!-- Examination Taken -->

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        b. Examination Taken:
                                    </span>

                                    <div class="radio-group">

                                        <div class="radio-item">

                                            <input type="radio" id="waec" name="examinationTaken" value="WAEC"
                                                <%=student && student.examinationTaken==="WAEC" ? "checked" : "" %>
                                            >

                                            <label for="waec">
                                                WAEC
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="neco" name="examinationTaken" value="NECO"
                                                <%=student && student.examinationTaken==="NECO" ? "checked" : "" %>
                                            >

                                            <label for="neco">
                                                NECO
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="bothExam" name="examinationTaken" value="Both"
                                                <%=student && student.examinationTaken==="Both" ? "checked" : "" %>
                                            >

                                            <label for="bothExam">
                                                Both
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="othersExam" name="examinationTaken" value="Others"
                                                <%=student && student.examinationTaken==="Others" ? "checked" : "" %>
                                            >

                                            <label for="othersExam">
                                                Others
                                            </label>

                                        </div>

                                    </div>

                                    <div class="form-group" style="margin-top: 10px;">

                                        <label for="otherExamination">
                                            If Others, please specify:
                                        </label>

                                        <input type="text" id="otherExamination" name="otherExamination"
                                            value="<%= student ? student.otherExamination : '' %>"
                                            placeholder="Specify other examination">

                                    </div>

                                </div>

                                <!-- Examination Result Upload -->

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        c. Upload Examination Results:
                                    </span>

                                    <p style="
                                    font-size: 12px;
                                    color: #666;
                                    margin-bottom: 15px;
                                ">
                                        Please upload a clear copy of your WAEC
                                        and/or NECO result. Accepted formats:
                                        JPG, PNG, PDF (Max 5MB).
                                    </p>

                                    <div class="form-grid">

                                        <!-- WAEC -->

                                        <div class="form-group">

                                            <label for="waecResult">
                                                WAEC Result
                                            </label>

                                            <div class="file-upload-wrapper">

                                                <input type="file" id="waecResult" name="waecResult"
                                                    accept="image/jpeg,image/png,image/jpg,application/pdf">

                                                <div class="file-upload-area"
                                                    onclick="document.getElementById('waecResult').click()">

                                                    <i class="fas fa-cloud-upload-alt"></i>

                                                    <span>
                                                        Click to upload WAEC Result
                                                    </span>

                                                </div>

                                                <div id="waecPreview" class="file-preview"></div>

                                            </div>

                                        </div>

                                        <!-- NECO -->

                                        <div class="form-group">

                                            <label for="necoResult">
                                                NECO Result
                                            </label>

                                            <div class="file-upload-wrapper">

                                                <input type="file" id="necoResult" name="necoResult"
                                                    accept="image/jpeg,image/png,image/jpg,application/pdf">

                                                <div class="file-upload-area"
                                                    onclick="document.getElementById('necoResult').click()">

                                                    <i class="fas fa-cloud-upload-alt"></i>

                                                    <span>
                                                        Click to upload NECO Result
                                                    </span>

                                                </div>

                                                <div id="necoPreview" class="file-preview"></div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <!-- Credentials -->

                                <div class="sub-section">

                                    <span class="sub-section-label">
                                        d. Credentials:
                                    </span>

                                    <div class="checkbox-group">

                                        <div class="checkbox-item">

                                            <input type="checkbox" id="credentialsEnclosed" name="credentialsEnclosed"
                                                value="true" <%=student && student.credentialsEnclosed ? "checked" : ""
                                                %>
                                            >

                                            <label for="credentialsEnclosed">
                                                Mark "X" if credentials are enclosed
                                            </label>

                                        </div>

                                        <div class="checkbox-item">

                                            <input type="checkbox" id="awaitingResult" name="awaitingResult"
                                                value="true" <%=student && student.awaitingResult ? "checked" : "" %>
                                            >

                                            <label for="awaitingResult">
                                                Mark "AR" if awaiting result
                                            </label>

                                        </div>

                                    </div>

                                </div>

                            </div>

                            <!-- =========================================
                         PART 5
                    ========================================== -->

                            <div class="form-part">

                                <h3>
                                    <i class="fas fa-info"></i>
                                    5. INTRODUCTION TO LEGEND COLLEGE
                                </h3>

                                <div class="sub-section">

                                    <span class="sub-section-label">

                                        Please indicate the source of your
                                        introduction to the college:

                                    </span>

                                    <div class="radio-group">

                                        <div class="radio-item">

                                            <input type="radio" id="advertisement" name="introductionSource"
                                                value="Advertisement" <%=student &&
                                                student.introductionSource==="Advertisement" ? "checked" : "" %>
                                            >

                                            <label for="advertisement">
                                                Advertisement
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="studentSource" name="introductionSource"
                                                value="Student" <%=student && student.introductionSource==="Student"
                                                ? "checked" : "" %>
                                            >

                                            <label for="studentSource">
                                                Student
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="parentSource" name="introductionSource"
                                                value="Parent" <%=student && student.introductionSource==="Parent"
                                                ? "checked" : "" %>
                                            >

                                            <label for="parentSource">
                                                Parent
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="staffSource" name="introductionSource" value="Staff"
                                                <%=student && student.introductionSource==="Staff" ? "checked" : "" %>
                                            >

                                            <label for="staffSource">
                                                Staff
                                            </label>

                                        </div>

                                        <div class="radio-item">

                                            <input type="radio" id="otherSource" name="introductionSource" value="Other"
                                                <%=student && student.introductionSource==="Other" ? "checked" : "" %>
                                            >

                                            <label for="otherSource">
                                                Other
                                            </label>

                                        </div>

                                    </div>

                                </div>

                                <div class="sub-section">

                                    <div class="form-group">

                                        <label for="otherSource">
                                            If Other, please specify:
                                        </label>

                                        <input type="text" id="otherSource" name="otherSource"
                                            value="<%= student ? student.otherSource : '' %>"
                                            placeholder="Specify other source">

                                    </div>

                                </div>

                            </div>

                            <!-- =========================================
                         PART 6
                    ========================================== -->

                            <div class="declaration-box">

                                <h4>
                                    <i class="fas fa-file-signature"></i>
                                    6. DECLARATION
                                </h4>

                                <p class="declaration-text">

                                    I,
                                    <input type="text" id="declarationName" name="declarationName"
                                        placeholder="Enter your full name" style="
                                    display: inline-block;
                                    width: auto;
                                    min-width: 220px;
                                    padding: 5px 10px;
                                " required>

                                    hereby declare that all the information
                                    given in this form is to the best of my
                                    knowledge correct.

                                </p>

                                <div class="checkbox-item" style="margin-top: 15px;">

                                    <input type="checkbox" id="declaration" name="declaration" value="true" <%=student
                                        && student.declaration ? "checked" : "" %>
                                    required
                                    >

                                    <label for="declaration">

                                        I agree to the declaration above

                                        <span class="required">
                                            *
                                        </span>

                                    </label>

                                </div>

                            </div>

                            <!-- =========================================
                         SUBMIT
                    ========================================== -->

                            <button type="submit" class="submit-btn">

                                <i class="fas fa-arrow-right"></i>

                                Save & Continue to Payment

                            </button>

                        </form>

            </div>

        </div>

    </div>

    <script>

        // =====================================================
        // AGE VALIDATION
        // =====================================================

        const today = new Date();

        const maxDate = new Date(
            today.getFullYear() - 16,
            today.getMonth(),
            today.getDate()
        );

        const dobInput =
            document.getElementById("dateOfBirth");

        if (dobInput) {

            dobInput.max =
                maxDate.toISOString().split("T")[0];

        }

        // =====================================================
        // PASSPORT PHOTO PREVIEW
        // =====================================================

        const passportInput =
            document.getElementById("passportPhoto");

        const passportArea =
            document.getElementById("passportArea");

        if (passportInput && passportArea) {

            passportInput.addEventListener(
                "change",
                function () {

                    if (
                        !this.files ||
                        !this.files[0]
                    ) {
                        return;
                    }

                    const file =
                        this.files[0];

                    if (
                        !file.type.startsWith("image/")
                    ) {
                        alert(
                            "Please select a JPG or PNG image."
                        );

                        this.value = "";

                        return;
                    }

                    const reader =
                        new FileReader();

                    reader.onload =
                        function (event) {

                            passportArea.innerHTML = "";

                            const img =
                                document.createElement("img");

                            img.src =
                                event.target.result;

                            img.alt =
                                "Passport Preview";

                            passportArea.appendChild(
                                img
                            );

                            passportArea.appendChild(
                                passportInput
                            );

                        };

                    reader.readAsDataURL(file);

                }
            );

        }

        // =====================================================
        // FILE PREVIEW
        // =====================================================

        function previewFile(
            input,
            previewId
        ) {

            const preview =
                document.getElementById(
                    previewId
                );

            if (!preview) {
                return;
            }

            preview.innerHTML = "";

            if (
                !input.files ||
                !input.files[0]
            ) {
                return;
            }

            const file =
                input.files[0];

            const fileUrl =
                URL.createObjectURL(file);

            if (
                file.type.startsWith("image/")
            ) {

                const img =
                    document.createElement("img");

                img.src = fileUrl;

                img.alt =
                    "File Preview";

                preview.appendChild(img);

            } else if (
                file.type ===
                "application/pdf"
            ) {

                const wrapper =
                    document.createElement("div");

                wrapper.className =
                    "pdf-preview";

                wrapper.innerHTML =
                    '<i class="fas fa-file-pdf"></i>' +
                    "<span>" +
                    file.name +
                    "</span>";

                preview.appendChild(
                    wrapper
                );

            } else {

                const wrapper =
                    document.createElement("div");

                wrapper.className =
                    "pdf-preview";

                wrapper.innerHTML =
                    '<i class="fas fa-file"></i>' +
                    "<span>" +
                    file.name +
                    "</span>";

                preview.appendChild(
                    wrapper
                );

            }

        }

        const waecResult =
            document.getElementById(
                "waecResult"
            );

        if (waecResult) {

            waecResult.addEventListener(
                "change",
                function () {

                    previewFile(
                        this,
                        "waecPreview"
                    );

                }
            );

        }

        const necoResult =
            document.getElementById(
                "necoResult"
            );

        if (necoResult) {

            necoResult.addEventListener(
                "change",
                function () {

                    previewFile(
                        this,
                        "necoPreview"
                    );

                }
            );

        }

        // =====================================================
        // FORM SUBMISSION LOADING STATE
        // =====================================================

        const applicationForm =
            document.getElementById(
                "applicationForm"
            );

        if (applicationForm) {

            applicationForm.addEventListener(
                "submit",
                function () {

                    const submitBtn =
                        applicationForm.querySelector(
                            ".submit-btn"
                        );

                    if (submitBtn) {

                        submitBtn.innerHTML =
                            '<i class="fas fa-spinner fa-spin"></i> ' +
                            "Submitting... Please wait";

                        submitBtn.disabled =
                            true;

                        submitBtn.style.opacity =
                            "0.7";

                        submitBtn.style.cursor =
                            "not-allowed";

                    }

                }
            );

        }

    </script>

</body>

</html>