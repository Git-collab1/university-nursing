<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Form | Legend College of Nursing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/admission.css">
    <style>
        .comprehensive-form {
            max-width: 900px;
            margin: 0 auto;
            background: #fff;
            padding: 30px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        }
        
        .form-header-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 2px solid #00695c;
        }
        
        .header-info {
            text-align: center;
            flex: 1;
        }
        
        .header-info h1 {
            color: #00695c;
            font-size: 24px;
            margin-bottom: 5px;
        }
        
        .header-info p {
            font-size: 14px;
            color: #666;
        }
        
        .receipt-section {
            display: flex;
            flex-direction: column;
            gap: 10px;
            min-width: 150px;
        }
        
        .receipt-field {
            display: flex;
            flex-direction: column;
        }
        
        .receipt-field label {
            font-size: 12px;
            font-weight: 600;
            color: #333;
            margin-bottom: 2px;
        }
        
        .receipt-field input {
            padding: 6px 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            font-size: 14px;
            width: 100%;
        }
        
        .passport-area {
            width: 120px;
            height: 140px;
            border: 2px dashed #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            background: #f9f9f9;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .passport-area:hover {
            border-color: #00695c;
            background: #f0f7f6;
        }
        
        .passport-area i {
            font-size: 30px;
            color: #999;
            margin-bottom: 5px;
        }
        
        .passport-area span {
            font-size: 11px;
            color: #666;
            text-align: center;
        }
        
        .instructions-box {
            background: #fff3cd;
            border: 1px solid #ffc107;
            padding: 15px;
            margin-bottom: 25px;
            border-radius: 5px;
        }
        
        .instructions-box h4 {
            color: #856404;
            margin-bottom: 10px;
            font-size: 16px;
        }
        
        .instructions-box ol {
            margin: 0;
            padding-left: 20px;
            color: #856404;
            font-size: 14px;
        }
        
        .instructions-box li {
            margin-bottom: 5px;
        }
        
        .instructions-box .note {
            font-weight: 600;
            margin-top: 10px;
        }
        
        .form-part {
            margin-bottom: 30px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
        }
        
        .form-part h3 {
            color: #00695c;
            border-bottom: 2px solid #00695c;
            padding-bottom: 10px;
            margin-bottom: 20px;
            font-size: 18px;
        }
        
        .form-part .sub-section {
            margin-bottom: 20px;
        }
        
        .form-part .sub-section-label {
            font-weight: 600;
            color: #333;
            margin-bottom: 15px;
            display: block;
            font-size: 15px;
        }
        
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
        }
        
        .form-group.full-width {
            grid-column: 1 / -1;
        }
        
        .form-group label {
            font-size: 13px;
            font-weight: 500;
            color: #333;
            margin-bottom: 5px;
        }
        
        .form-group label .required {
            color: #e74c3c;
        }
        
        .form-group input[type="text"],
        .form-group input[type="email"],
        .form-group input[type="tel"],
        .form-group input[type="date"],
        .form-group select,
        .form-group textarea {
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            font-family: inherit;
            transition: border-color 0.3s;
        }
        
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            outline: none;
            border-color: #00695c;
        }
        
        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }
        
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-top: 10px;
        }
        
        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .checkbox-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #00695c;
        }
        
        .checkbox-item label {
            font-size: 14px;
            cursor: pointer;
        }
        
        .radio-group {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 10px;
        }
        
        .radio-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }
        
        .radio-item input[type="radio"] {
            width: 18px;
            height: 18px;
            accent-color: #00695c;
        }
        
        .radio-item label {
            font-size: 14px;
            cursor: pointer;
        }
        
        .exam-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 13px;
        }
        
        .exam-table th,
        .exam-table td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
        }
        
        .exam-table th {
            background: #00695c;
            color: #fff;
            font-weight: 600;
        }
        
        .exam-table input {
            width: 100%;
            border: none;
            background: transparent;
            text-align: center;
            font-size: 13px;
        }
        
        .exam-table input:focus {
            outline: none;
            background: #f0f7f6;
        }
        
        .declaration-box {
            background: #e8f5e9;
            border: 2px solid #00695c;
            padding: 20px;
            border-radius: 8px;
            margin-top: 25px;
        }
        
        .declaration-box h4 {
            color: #00695c;
            margin-bottom: 15px;
        }
        
        .declaration-text {
            font-size: 14px;
            line-height: 1.6;
            color: #333;
        }
        
        .declaration-signature {
            margin-top: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }
        
        .declaration-signature input {
            padding: 8px 12px;
            border: 1px solid #ccc;
            border-radius: 4px;
            flex: 1;
            min-width: 200px;
        }
        
        .submit-btn {
            background: #00695c;
            color: #fff;
            padding: 15px 30px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            margin-top: 25px;
            transition: background 0.3s;
        }
        
        .submit-btn:hover {
            background: #004d40;
        }
        
        @media (max-width: 768px) {
            .form-header-section {
                flex-direction: column;
                gap: 20px;
            }
            
            .passport-area {
                width: 100%;
                height: 120px;
            }
            
            .form-grid {
                grid-template-columns: 1fr;
            }
            
            .exam-table-wrapper {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                margin-bottom: 15px;
            }
            
            .exam-table {
                font-size: 11px;
                min-width: 500px;
            }
            
            .exam-table th,
            .exam-table td {
                padding: 5px;
                white-space: nowrap;
            }
            
            .comprehensive-form {
                padding: 15px;
                overflow-x: hidden;
            }
        }
    </style>
</head>

<body>
    <!-- Floating Social Media Buttons -->
    <div class="floating-social">
        <a href="https://facebook.com" target="_blank" class="facebook" title="Facebook">
            <i class="fab fa-facebook-f"></i>
        </a>
        <a href="https://wa.me/2348131820224" target="_blank" class="whatsapp" title="WhatsApp">
            <i class="fab fa-whatsapp"></i>
        </a>
    </div>

    <!-- Form Page -->
    <div class="form-page">
        <div class="container">
            <div class="application-form">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-error"><%= error %></div>
                <% } %>

                <form action="/student-submit-form" method="POST" id="applicationForm" enctype="multipart/form-data" class="comprehensive-form">
                    
                    <!-- Header Section -->
                    <div class="form-header-section">
                        <div class="header-info">
                            <h1>LEGEND COLLEGE OF NURSING SCIENCE</h1>
                            <p>Application Form for Admission</p>
                        </div>
                        <div class="receipt-section">
                            <div class="receipt-field">
                                <label for="receiptNo">Receipt No.</label>
                                <input type="text" id="receiptNo" name="receiptNo" value="<%= student ? student.receiptNo : '' %>" placeholder="Enter receipt number">
                            </div>
                            <div class="receipt-field">
                                <label for="applicationDate">Application Date</label>
                                <input type="date" id="applicationDate" name="applicationDate" value="<%= student && student.applicationDate ? student.applicationDate.toISOString().split('T')[0] : '' %>">
                            </div>
                        </div>
                        <div class="passport-area" onclick="document.getElementById('passportPhoto').click()">
                            <i class="fas fa-camera"></i>
                            <span>Candidate's Passport</span>
                            <input type="file" id="passportPhoto" name="passportPhoto" accept="image/*" style="display: none;" onchange="previewPassport(this)">
                        </div>
                    </div>

                    <!-- Instructions -->
                    <div class="instructions-box">
                        <h4><i class="fas fa-info-circle"></i> Important Instructions</h4>
                        <ol>
                            <li>Please complete this form in <strong>BLACK INK</strong></li>
                            <li>Tick the box which applies to you</li>
                            <li>Return with the following:
                                <ul>
                                    <li>i. Photocopies of your credentials</li>
                                    <li>ii. Four passport-sized photographs (not more than three months old)</li>
                                    <li>iii. An international passport</li>
                                </ul>
                            </li>
                        </ol>
                        <p class="note">Note: Incomplete forms will not be processed.</p>
                    </div>

                    <!-- Part 1: Personal Data of Applicant -->
                    <div class="form-part">
                        <h3><i class="fas fa-user"></i> 1. PERSONAL DATA OF APPLICANT</h3>
                        
                        <div class="sub-section">
                            <span class="sub-section-label">a. Name:</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="title">Title <span class="required">*</span></label>
                                    <select id="title" name="title">
                                        <option value="">Select</option>
                                        <option value="Mr." <%= student && student.title === 'Mr.' ? 'selected' : '' %>>Mr.</option>
                                        <option value="Miss" <%= student && student.title === 'Miss' ? 'selected' : '' %>>Miss</option>
                                        <option value="Mrs." <%= student && student.title === 'Mrs.' ? 'selected' : '' %>>Mrs.</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="firstName">First Name <span class="required">*</span></label>
                                    <input type="text" id="firstName" name="firstName" value="<%= student ? student.firstName : '' %>" placeholder="Enter first name" required>
                                </div>
                                <div class="form-group">
                                    <label for="lastName">Last Name <span class="required">*</span></label>
                                    <input type="text" id="lastName" name="lastName" value="<%= student ? student.lastName : '' %>" placeholder="Enter last name" required>
                                </div>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">b. Contact Address:</span>
                            <div class="form-group full-width">
                                <textarea id="contactAddress" name="contactAddress" placeholder="Enter your contact address" rows="2"><%= student && student.contactAddress ? student.contactAddress : '' %></textarea>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">c. Sex: &nbsp;&nbsp; Date of Birth:</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label>Sex <span class="required">*</span></label>
                                    <div class="radio-group">
                                        <div class="radio-item">
                                            <input type="radio" id="male" name="gender" value="Male" <%= student && student.gender === 'Male' ? 'checked' : '' %> required>
                                            <label for="male">Male</label>
                                        </div>
                                        <div class="radio-item">
                                            <input type="radio" id="female" name="gender" value="Female" <%= student && student.gender === 'Female' ? 'checked' : '' %> required>
                                            <label for="female">Female</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label for="dateOfBirth">Date of Birth <span class="required">*</span></label>
                                    <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= student && student.dateOfBirth ? student.dateOfBirth.toISOString().split('T')[0] : '' %>" required>
                                </div>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">d. Marital Status (Maiden name for married ladies):</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="maritalStatus">Marital Status <span class="required">*</span></label>
                                    <select id="maritalStatus" name="maritalStatus">
                                        <option value="">Select</option>
                                        <option value="Single" <%= student && student.maritalStatus === 'Single' ? 'selected' : '' %>>Single</option>
                                        <option value="Married" <%= student && student.maritalStatus === 'Married' ? 'selected' : '' %>>Married</option>
                                        <option value="Divorced" <%= student && student.maritalStatus === 'Divorced' ? 'selected' : '' %>>Divorced</option>
                                        <option value="Widowed" <%= student && student.maritalStatus === 'Widowed' ? 'selected' : '' %>>Widowed</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="maidenName">Maiden Name (if married)</label>
                                    <input type="text" id="maidenName" name="maidenName" value="<%= student ? student.maidenName : '' %>" placeholder="Enter maiden name">
                                </div>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">e. Phone No.: &nbsp;&nbsp; Email:</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="phone">Phone Number <span class="required">*</span></label>
                                    <input type="tel" id="phone" name="phone" value="<%= student ? student.phone : '' %>" placeholder="+234 xxx xxx xxxx" required>
                                </div>
                                <div class="form-group">
                                    <label for="email">Email <span class="required">*</span></label>
                                    <input type="email" id="email" name="email" value="<%= student ? student.email : '' %>" placeholder="Enter email address" required>
                                </div>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">f. State of Origin: &nbsp;&nbsp; Nationality:</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="stateOfOrigin">State of Origin <span class="required">*</span></label>
                                    <input type="text" id="stateOfOrigin" name="stateOfOrigin" value="<%= student ? student.stateOfOrigin : '' %>" placeholder="Enter state" required>
                                </div>
                                <div class="form-group">
                                    <label for="nationality">Nationality <span class="required">*</span></label>
                                    <input type="text" id="nationality" name="nationality" value="<%= student ? student.nationality : 'Nigerian' %>" required>
                                </div>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">g. Local Government Area:</span>
                            <div class="form-group">
                                <input type="text" id="localGovernmentArea" name="localGovernmentArea" value="<%= student ? student.localGovernmentArea : '' %>" placeholder="Enter LGA">
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">h. Extra Curricular Activities (Sports, Hobbies, etc.):</span>
                            <div class="form-group full-width">
                                <textarea id="extraCurricularActivities" name="extraCurricularActivities" placeholder="List any sports, hobbies, or extra-curricular activities" rows="2"><%= student && student.extraCurricularActivities ? student.extraCurricularActivities : '' %></textarea>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">i. Medical History:</span>
                            <div class="form-group full-width">
                                <textarea id="medicalHistory" name="medicalHistory" placeholder="List any medical conditions or history" rows="2"><%= student && student.medicalHistory ? student.medicalHistory : '' %></textarea>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">j. Genotype:</span>
                            <div class="form-group">
                                <select id="genotype" name="genotype">
                                    <option value="">Select</option>
                                    <option value="AA" <%= student && student.genotype === 'AA' ? 'selected' : '' %>>AA</option>
                                    <option value="AS" <%= student && student.genotype === 'AS' ? 'selected' : '' %>>AS</option>
                                    <option value="SS" <%= student && student.genotype === 'SS' ? 'selected' : '' %>>SS</option>
                                    <option value="AC" <%= student && student.genotype === 'AC' ? 'selected' : '' %>>AC</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Part 2: Information About Applicant's Parents -->
                    <div class="form-part">
                        <h3><i class="fas fa-users"></i> 2. INFORMATION ABOUT APPLICANT'S PARENTS</h3>
                        
                        <div class="sub-section">
                            <span class="sub-section-label">a. Father's Full Name:</span>
                            <div class="form-group">
                                <input type="text" id="fatherFullName" name="fatherFullName" value="<%= student ? student.fatherFullName : '' %>" placeholder="Enter father's full name">
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">b. Father's Contact Address:</span>
                            <div class="form-group full-width">
                                <textarea id="fatherContactAddress" name="fatherContactAddress" placeholder="Enter father's contact address" rows="2"><%= student && student.fatherContactAddress ? student.fatherContactAddress : '' %></textarea>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">c. Phone No.: &nbsp;&nbsp; Email:</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="fatherPhone">Father's Phone</label>
                                    <input type="tel" id="fatherPhone" name="fatherPhone" value="<%= student ? student.fatherPhone : '' %>" placeholder="+234 xxx xxx xxxx">
                                </div>
                                <div class="form-group">
                                    <label for="fatherEmail">Father's Email</label>
                                    <input type="email" id="fatherEmail" name="fatherEmail" value="<%= student ? student.fatherEmail : '' %>" placeholder="Enter email">
                                </div>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">d. Mother's Full Name: &nbsp;&nbsp; Maiden Name:</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="motherFullName">Mother's Full Name</label>
                                    <input type="text" id="motherFullName" name="motherFullName" value="<%= student ? student.motherFullName : '' %>" placeholder="Enter mother's full name">
                                </div>
                                <div class="form-group">
                                    <label for="motherMaidenName">Mother's Maiden Name</label>
                                    <input type="text" id="motherMaidenName" name="motherMaidenName" value="<%= student ? student.motherMaidenName : '' %>" placeholder="Enter maiden name">
                                </div>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">e. Mother's Contact Address (if different from father's):</span>
                            <div class="form-group full-width">
                                <textarea id="motherContactAddress" name="motherContactAddress" placeholder="Enter mother's contact address if different from father's" rows="2"><%= student && student.motherContactAddress ? student.motherContactAddress : '' %></textarea>
                            </div>
                        </div>

                        <div class="sub-section">
                            <span class="sub-section-label">f. Phone No.: &nbsp;&nbsp; Email:</span>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="motherPhone">Mother's Phone</label>
                                    <input type="tel" id="motherPhone" name="motherPhone" value="<%= student ? student.motherPhone : '' %>" placeholder="+234 xxx xxx xxxx">
                                </div>
                                <div class="form-group">
                                    <label for="motherEmail">Mother's Email</label>
                                    <input type="email" id="motherEmail" name="motherEmail" value="<%= student ? student.motherEmail : '' %>" placeholder="Enter email">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Part 3: Choice of Course -->
                    <div class="form-part">
                        <h3><i class="fas fa-book"></i> 3. CHOICE OF COURSE</h3>
                        
<div class="sub-section">
                             <span class="sub-section-label">a. Please tick the box to indicate your choice:</span>
                             <div class="radio-group">
                                 <div class="radio-item">
                                     <input type="radio" id="hndNursing" name="program" value="HND Nursing" <%= student && student.program === 'HND Nursing' ? 'checked' : '' %>>
                                     <label for="hndNursing">HND Nursing</label>
                                 </div>
                                 <div class="radio-item">
                                     <input type="radio" id="bnsNursing" name="program" value="BNS.c Nursing" <%= student && student.program === 'BNS.c Nursing' ? 'checked' : '' %>>
                                     <label for="bnsNursing">BNS.c Nursing</label>
                                 </div>
                             </div>
                         </div>

                        <div class="sub-section">
                            <span class="sub-section-label">b. Program Transfer:</span>
                            <div class="form-group">
                                <label>Will you like to finish your academic program outside Nigeria?</label>
                                <div class="radio-group">
                                    <div class="radio-item">
                                        <input type="radio" id="transferYes" name="programTransfer" value="Yes" <%= student && student.programTransfer === 'Yes' ? 'checked' : '' %>>
                                        <label for="transferYes">Yes</label>
                                    </div>
                                    <div class="radio-item">
                                        <input type="radio" id="transferNo" name="programTransfer" value="No" <%= student && student.programTransfer === 'No' ? 'checked' : '' %>>
                                        <label for="transferNo">No</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Part 4: Education -->
                    <div class="form-part">
                        <h3><i class="fas fa-graduation-cap"></i> 4. EDUCATION</h3>
                        
<div class="sub-section">
                             <span class="sub-section-label">a. Examination Taken:</span>
                             <div class="radio-group">
                                 <div class="radio-item">
                                     <input type="radio" id="waec" name="examinationTaken" value="WAEC" <%= student && student.examinationTaken === 'WAEC' ? 'checked' : '' %>>
                                     <label for="waec">WAEC</label>
                                 </div>
                                 <div class="radio-item">
                                     <input type="radio" id="neco" name="examinationTaken" value="NECO" <%= student && student.examinationTaken === 'NECO' ? 'checked' : '' %>>
