    <script>
        // Calculate maximum date (must be at least 16 years old)
        const today = new Date();
        const maxDate = new Date(today.getFullYear() - 16, today.getMonth(), today.getDate());
        
        const dobInput = document.getElementById('dateOfBirth');
        if (dobInput) {
            dobInput.max = maxDate.toISOString().split('T')[0];
        }

// Passport photo preview
        function previewPassport(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const passportArea = input.parentElement;
                    const existingInput = passportArea.querySelector('input[type="file"]');
                    passportArea.innerHTML = '';
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.cssText = 'width: 100%; height: 100%; object-fit: cover;';
                    passportArea.appendChild(img);
                    passportArea.appendChild(existingInput);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
     </script>
