<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Submitted | Legend College of Nursing</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/admission.css">
</head>

<body>
    <!-- Success Page -->
    <div class="success-page">
        <div class="success-card">
            <div class="success-icon">
                <i class="fas fa-check"></i>
            </div>
            <h2>Application Submitted!</h2>
            <p>Your application has been successfully submitted. You will receive a confirmation email shortly at <strong><%= email %></strong>.</p>
            
            <div class="application-id">
                Application ID: <strong><%= applicationId %></strong>
            </div>

            <p>Our admissions team will review your application and get back to you within 5-7 business days.</p>
            
            <a href="/student-login" class="home-btn">Track Application</a>
        </div>
    </div>
</body>

</html>
