<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Application Submitted | Legend College of Nursing And Emergency Health Sciences Nnewi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/admission.css">
    <style>
        .success-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .success-popup {
            background: #fff;
            border-radius: 20px;
            padding: 40px;
            max-width: 500px;
            width: 100%;
            text-align: center;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.25);
            animation: slideUp 0.5s ease-out;
            position: relative;
            overflow: hidden;
        }

        .success-popup::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(135deg, #0D6E6E, #14919B);
        }

        @keyframes slideUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .success-popup .icon-circle {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #0D6E6E, #14919B);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            animation: scaleIn 0.5s ease-out 0.2s both;
        }

        @keyframes scaleIn {
            from {
                transform: scale(0);
            }
            to {
                transform: scale(1);
            }
        }

        .success-popup .icon-circle i {
            font-size: 36px;
            color: #fff;
        }

        .success-popup h2 {
            font-family: 'Playfair Display', serif;
            color: #0D6E6E;
            font-size: 1.8rem;
            margin-bottom: 12px;
        }

        .success-popup .message {
            color: #5D6D7E;
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .success-popup .application-id-box {
            background: #f0f8f8;
            border: 2px dashed #0D6E6E;
            border-radius: 12px;
            padding: 15px 20px;
            margin-bottom: 25px;
        }

        .success-popup .application-id-box .label {
            font-size: 0.85rem;
            color: #5D6D7E;
            margin-bottom: 5px;
        }

        .success-popup .application-id-box .value {
            font-size: 1.3rem;
            font-weight: 700;
            color: #0D6E6E;
            letter-spacing: 1px;
        }

        .success-popup .home-btn {
            display: inline-block;
            background: linear-gradient(135deg, #0D6E6E 0%, #14919B 100%);
            color: #fff;
            padding: 14px 40px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            font-size: 1rem;
            box-shadow: 0 8px 25px rgba(13, 110, 110, 0.3);
        }

        .success-popup .home-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(13, 110, 110, 0.4);
            color: #fff;
        }

        .success-popup .note {
            font-size: 0.85rem;
            color: #95a5a6;
            margin-top: 15px;
        }

        @media (max-width: 480px) {
            .success-overlay {
                padding: 15px;
                align-items: flex-end;
            }

            .success-popup {
                padding: 30px 20px;
                border-radius: 20px 20px 0 0;
                max-width: 100%;
            }

            .success-popup .icon-circle {
                width: 64px;
                height: 64px;
            }

            .success-popup .icon-circle i {
                font-size: 28px;
            }

            .success-popup h2 {
                font-size: 1.5rem;
            }

            .success-popup .message {
                font-size: 0.9rem;
            }

            .success-popup .application-id-box {
                padding: 12px 15px;
            }

            .success-popup .application-id-box .value {
                font-size: 1.1rem;
            }

            .success-popup .home-btn {
                width: 100%;
                padding: 14px 20px;
                font-size: 0.95rem;
            }
        }
    </style>
</head>

<body>
    <div class="success-overlay">
        <div class="success-popup">
            <div class="icon-circle">
                <i class="fas fa-check"></i>
            </div>
            <h2>Application Submitted!</h2>
            <p class="message">
                Your application has been successfully submitted. Please check your email at <strong><%= email %></strong> for your application confirmation. We will get back to you shortly.
            </p>

            <div class="application-id-box">
                <div class="label">Application ID</div>
                <div class="value"><%= applicationId %></div>
            </div>

            <a href="/" class="home-btn">Go to Home</a>
            <p class="note">Redirecting automatically in <span id="countdown">5</span> seconds...</p>
        </div>
    </div>

    <script>
        let countdown = 5;
        const countdownEl = document.getElementById('countdown');

        const timer = setInterval(function() {
            countdown--;
            if (countdownEl) {
                countdownEl.textContent = countdown;
            }
            if (countdown <= 0) {
                clearInterval(timer);
                window.location.href = '/';
            }
        }, 1000);
    </script>
</body>

</html>
